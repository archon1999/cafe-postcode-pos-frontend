{
  "name": "pos-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "vite build && npm run pwa:inject",
    "prod:build": "vite build --mode production && npm run pwa:inject",
    "pwa:inject": "node scripts/inject-sw-manifest.mjs",
    "test:pwa": "node scripts/test-pwa-build.mjs",
    "audio:generate:monitor": "node scripts/generate-monitor-announcements.mjs",
    "lint:ts": "eslint \"**/*.{ts,tsx}\" --max-warnings 0",
    "lint:ts:fix": "eslint \"**/*.{ts,tsx}\" --fix --max-warnings 0",
    "lint:css": "stylelint \"**/*.css\" --allow-empty-input",
    "lint:css:fix": "stylelint \"**/*.css\" --fix",
    "lint": "concurrently \"npm run lint:ts\" \"npm run lint:css\"",
    "test": "vitest run",
    "unit": "vitest",
    "unit:watch": "vitest watch",
    "docker:build": "docker build -t postcode/pos-frontend:local .",
    "docker:up": "docker compose --env-file .env.production up -d --build"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/dm-sans": "^5.2.6",
    "@fontsource-variable/inter": "^5.2.6",
    "@iconify/react": "^6.0.0",
    "@mui/material": "^7.3.1",
    "@tanstack/react-query": "^5.90.2",
    "axios": "^1.11.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router": "7.18.2",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@tanstack/eslint-plugin-query": "^5.91.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.3.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/react-router": "^5.1.20",
    "@vitejs/plugin-legacy": "^7.2.1",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/browser": "3.2.7",
    "concurrently": "9.2.4",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-i18next": "^6.1.3",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "fake-indexeddb": "^6.2.5",
    "ffmpeg-static": "^5.3.0",
    "globals": "^16.4.0",
    "jsdom": "^26.1.0",
    "playwright": "1.62.1",
    "prettier": "^3.6.2",
    "sass-embedded": "^1.92.1",
    "stylelint": "^16.24.0",
    "stylelint-config-standard-scss": "^15.0.1",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.43.0",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-arm64-musl": "^4.52.3",
    "@rollup/rollup-linux-x64-gnu": "^4.52.3"
  }
}
